__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.venv/
venv/

# Private run data and raw emulator saves must never enter source control.
.nuzlocke_data/
*.sav
*.srm

# These two sanitized/untrusted binary fixtures are required by the automated
# parser and backend tests. All user/emulator saves remain ignored elsewhere.
!tests/fixtures/*.sav

# Local tooling and temporary files.
.tmp_*/
*.log
.DS_Store
Thumbs.db
